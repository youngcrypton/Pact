    "near-api-js": "^4.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.543",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
