{
  "name": "pact-protocol",
  "version": "1.0.0",
  "description": "Pact: Earned Trust Coordination Protocol on NEAR for NEAR Hackathon 2026",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/prepare-dist.mjs",
    "build:cloudflare": "tsc && node scripts/prepare-dist.mjs",
    "test": "tsx --test tests/**/*.test.ts",
    "seed": "tsx scripts/seed-bounties.ts",
    "demo": "tsx scripts/demo-simulation.ts",
    "broadcast": "tsx scripts/broadcast-testnet.ts",
    "dev": "tsx src/index.ts",
    "video:render": "node scripts/render-demo.mjs",
    "video:still": "npx remotion still src/remotion/index.ts PacttDemo out/frame.png",
    "api": "tsx src/server.ts",
    "start": "tsx src/server.ts"
